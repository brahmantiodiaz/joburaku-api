<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8" />
  <title><%= personalInfo?.fullName || "Generated CV" %></title>

  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    @page {
      size: A4;
      margin: 16mm 14mm;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      margin: 0;
      padding: 0;
      background: #ffffff;
      color: #111827;
      font-size: 11.5px;
      line-height: 1.45;
    }

    .section {
      page-break-inside: avoid;
    }

    .item {
      page-break-inside: avoid;
    }

    ul {
      margin-top: 6px;
      padding-left: 18px;
    }

    li {
      margin-bottom: 4px;
    }
  </style>
</head>

<body class="bg-white text-gray-900">
  <main class="w-full">

    <header class="mb-5 border-b-2 border-gray-900 pb-4">
      <% const profileImage = personalInfo?.image || personalInfo?.imageUrl; %>

      <% if (profileImage) { %>
      <div class="flex items-center gap-5">
        <div class="shrink-0">
          <img src="<%= profileImage %>" alt="<%= personalInfo?.fullName || 'Profile Photo' %>" class="h-24 w-24 rounded-full border border-gray-300 object-cover" />
        </div>

        <div class="flex-1">
          <h1 class="text-[25px] font-bold uppercase leading-tight tracking-wide text-gray-900">
            <%= personalInfo?.fullName || "" %>
          </h1>

          <div class="mt-2 flex flex-wrap gap-x-2 gap-y-1 text-[10.5px] leading-relaxed text-gray-700">
            <% if (personalInfo?.address) { %>
            <span><%= personalInfo.address %></span>
            <% } %>

            <% if (personalInfo?.phoneNumber) { %>
            <% if (personalInfo?.address) { %><span>•</span><% } %>
            <span><%= personalInfo.phoneNumber %></span>
            <% } %>

            <% if (personalInfo?.linkedInUrl) { %>
            <% if (personalInfo?.address || personalInfo?.phoneNumber) { %><span>•</span><% } %>
            <span><%= personalInfo.linkedInUrl %></span>
            <% } %>
          </div>
        </div>
      </div>
      <% } else { %>
      <div class="text-center">
        <h1 class="text-[25px] font-bold uppercase leading-tight tracking-wide text-gray-900">
          <%= personalInfo?.fullName || "" %>
        </h1>

        <div class="mt-2 flex flex-wrap justify-center gap-x-2 gap-y-1 text-[10.5px] leading-relaxed text-gray-700">
          <% if (personalInfo?.address) { %>
          <span><%= personalInfo.address %></span>
          <% } %>

          <% if (personalInfo?.phoneNumber) { %>
          <% if (personalInfo?.address) { %><span>•</span><% } %>
          <span><%= personalInfo.phoneNumber %></span>
          <% } %>

          <% if (personalInfo?.linkedInUrl) { %>
          <% if (personalInfo?.address || personalInfo?.phoneNumber) { %><span>•</span><% } %>
          <span><%= personalInfo.linkedInUrl %></span>
          <% } %>
        </div>
      </div>
      <% } %>
    </header>

    <% if (professionalSummary) { %>
    <section class="section mb-4">
      <h2 class="mb-2 border-b border-gray-400 pb-1 text-[12.5px] font-bold uppercase tracking-[0.08em] text-gray-900">
        Professional Summary
      </h2>

      <p class="text-justify text-[11.5px] leading-relaxed text-gray-800">
        <%= professionalSummary %>
      </p>
    </section>
    <% } %>

    <% if (skills && skills.length) { %>
    <section class="section mb-4">
      <h2 class="mb-2 border-b border-gray-400 pb-1 text-[12.5px] font-bold uppercase tracking-[0.08em] text-gray-900">
        Core Skills
      </h2>

      <div class="flex flex-wrap gap-1.5">
        <% skills.forEach((skill) => { %>
        <span class="inline-block rounded-full border border-gray-300 bg-gray-50 px-2 py-1 text-[10.5px] leading-none text-gray-900">
          <%= skill %>
        </span>
        <% }) %>
      </div>
    </section>
    <% } %>

    <% if (workExperiences && workExperiences.length) { %>
    <section class="section mb-4">
      <h2 class="mb-2 border-b border-gray-400 pb-1 text-[12.5px] font-bold uppercase tracking-[0.08em] text-gray-900">
        Work Experience
      </h2>

      <% workExperiences.forEach((exp) => { %>
      <div class="item mb-3">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="text-[12px] font-bold leading-snug text-gray-900">
              <%= exp.position || "" %>
            </h3>

            <% if (exp.companyName) { %>
            <p class="text-[11.3px] font-semibold leading-snug text-gray-700">
              <%= exp.companyName %>
            </p>
            <% } %>
          </div>

          <% if (exp.period) { %>
          <p class="min-w-[120px] whitespace-nowrap text-right text-[10.5px] leading-snug text-gray-600">
            <%= exp.period %>
          </p>
          <% } %>
        </div>

        <% if (exp.description && Array.isArray(exp.description) && exp.description.length) { %>
        <ul class="mt-1.5 text-[11.3px] leading-relaxed text-gray-800">
          <% exp.description.forEach((item) => { %>
          <li><%= item %></li>
          <% }) %>
        </ul>
        <% } else if (exp.description) { %>
        <p class="mt-1.5 text-[11.3px] leading-relaxed text-gray-800">
          <%= exp.description %>
        </p>
        <% } %>
      </div>
      <% }) %>
    </section>
    <% } %>

    <% if (projects && projects.length) { %>
    <section class="section mb-4">
      <h2 class="mb-2 border-b border-gray-400 pb-1 text-[12.5px] font-bold uppercase tracking-[0.08em] text-gray-900">
        Projects
      </h2>

      <% projects.forEach((project) => { %>
      <div class="item mb-3">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="text-[12px] font-bold leading-snug text-gray-900">
              <%= project.name || project.title || "" %>
            </h3>

            <% if (project.techStack) { %>
            <p class="text-[11.3px] font-semibold leading-snug text-gray-700">
              <%= project.techStack %>
            </p>
            <% } %>
          </div>

          <% if (project.period) { %>
          <p class="min-w-[120px] whitespace-nowrap text-right text-[10.5px] leading-snug text-gray-600">
            <%= project.period %>
          </p>
          <% } %>
        </div>

        <% if (project.description && Array.isArray(project.description) && project.description.length) { %>
        <ul class="mt-1.5 text-[11.3px] leading-relaxed text-gray-800">
          <% project.description.forEach((item) => { %>
          <li><%= item %></li>
          <% }) %>
        </ul>
        <% } else if (project.description) { %>
        <p class="mt-1.5 text-[11.3px] leading-relaxed text-gray-800">
          <%= project.description %>
        </p>
        <% } %>
      </div>
      <% }) %>
    </section>
    <% } %>

    <% if (educations && educations.length) { %>
    <section class="section mb-4">
      <h2 class="mb-2 border-b border-gray-400 pb-1 text-[12.5px] font-bold uppercase tracking-[0.08em] text-gray-900">
        Education
      </h2>

      <% educations.forEach((edu) => { %>
      <div class="item mb-3">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="text-[12px] font-bold leading-snug text-gray-900">
              <%= edu.schoolName || "" %>
            </h3>

            <p class="text-[11.3px] font-semibold leading-snug text-gray-700">
              <%= edu.degree || "" %>
              <% if (edu.fieldOfStudy) { %>
              - <%= edu.fieldOfStudy %>
              <% } %>
              <% if (edu.score) { %>
              <span class="font-normal text-gray-600"> | <%= edu.score %></span>
              <% } %>
            </p>
          </div>

          <% if (edu.period) { %>
          <p class="min-w-[120px] whitespace-nowrap text-right text-[10.5px] leading-snug text-gray-600">
            <%= edu.period %>
          </p>
          <% } %>
        </div>

        <% if (edu.description) { %>
        <p class="mt-1.5 text-[11.3px] leading-relaxed text-gray-800">
          <%= edu.description %>
        </p>
        <% } %>
      </div>
      <% }) %>
    </section>
    <% } %>

    <% if (certifications && certifications.length) { %>
    <section class="section mb-4">
      <h2 class="mb-2 border-b border-gray-400 pb-1 text-[12.5px] font-bold uppercase tracking-[0.08em] text-gray-900">
        Certifications
      </h2>

      <ul class="text-[11.3px] leading-relaxed text-gray-800">
        <% certifications.forEach((cert) => { %>
        <% if (typeof cert === "string") { %>
        <li><%= cert %></li>
        <% } else { %>
        <li>
          <strong><%= cert.name || "" %></strong>
          <% if (cert.issuer) { %>
          - <%= cert.issuer %>
          <% } %>
          <% if (cert.issuedDate) { %>
          <span class="text-gray-600">(<%= cert.issuedDate %>)</span>
          <% } %>
        </li>
        <% } %>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <% if (languages && languages.length) { %>
    <section class="section mb-4">
      <h2 class="mb-2 border-b border-gray-400 pb-1 text-[12.5px] font-bold uppercase tracking-[0.08em] text-gray-900">
        Languages
      </h2>

      <ul class="grid grid-cols-2 gap-x-6 gap-y-1 pl-0 text-[11.3px] leading-relaxed text-gray-800 [list-style-position:inside]">
        <% languages.forEach((lang) => { %>
        <li>
          <% if (typeof lang === "string") { %>
          <%= lang %>
          <% } else { %>
          <%= lang.language || "" %>
          <% if (lang.level) { %>
          - <%= lang.level %>
          <% } %>
          <% } %>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

  </main>
</body>

</html>
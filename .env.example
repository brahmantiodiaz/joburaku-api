NODE_ENV=development
PORT=3000

DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_HOST=
DB_DIALECT=postgres

# Production database connection used when NODE_ENV=production.
DATABASE_URL=
# Keep false for Coolify's internal PostgreSQL network. Set true only when the database provider requires SSL.
DB_SSL=false

JWT_SECRET_KEY=

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

GOOGLE_CLIENT_ID=
GEMINI_API_KEY=

# Optional. Leave unset when using the Dockerfile because Puppeteer uses its downloaded Chrome build.
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_SKIP_DOWNLOAD=

MAIL_USER=
MAIL_PASSWORD=
CLIENT_URL=

RAPIDAPI_KEY=
RAPIDAPI_HOST=
